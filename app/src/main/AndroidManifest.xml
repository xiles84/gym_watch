<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Foreground service: required for the timer to keep firing while the
         screen is off. The `health` type and every health permission are gone
         with the exercise tracking that needed them — Samsung Health records
         workouts now (docs/LESSONS.md #2). Each remaining permission is
         declared by the module that uses it (#18); these are the app's own. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Samsung Health is opened by package name, the only supported way in.
         Wear OS still requires the target to be declared to be visible to
         PackageManager queries. -->
    <queries>
        <package android:name="com.samsung.android.wear.shealth" />
    </queries>

    <application
        android:name=".GymApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <!-- Tells the launcher this app is standalone: it does not need a
             phone-side companion to be useful. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- singleTop, or a launch while the app is already open never reaches
             onNewIntent: extras do not count when Android compares intents, so
             it only brings the task forward (docs/LESSONS.md #26). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
