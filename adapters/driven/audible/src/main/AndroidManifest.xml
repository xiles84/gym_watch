<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Audible's media button receiver is looked up and sent to from this
         module when Audible isn't running, and package visibility has to be
         declared for that lookup to find it (docs/LESSONS.md #18). -->
    <queries>
        <package android:name="com.audible.application" />
    </queries>
</manifest>
